# Copy to .env before: docker compose up --build
# cp .env.docker.example .env

# Required — used by n8n: Authorization: Bearer <this value>
BLOG_API_SECRET=change-me-to-a-long-random-secret

# Public site URL (sitemap + absolute blog URLs)
SITE_URL=http://localhost:8080

# Host ports
WEB_PORT=8080
BLOG_API_HOST_PORT=3005

# API listen port inside container (keep 3005)
BLOG_API_PORT=3005

# Frontend (build-time). Leave empty when using Docker nginx /api proxy
VITE_BLOG_API_URL=
