# Blog API (Express)
FROM node:22-alpine AS api
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server
COPY data ./data-seed
COPY docker/api-entrypoint.sh /api-entrypoint.sh
RUN sed -i 's/\r$//' /api-entrypoint.sh && chmod +x /api-entrypoint.sh && mkdir -p /app/data

ENV NODE_ENV=production
ENV BLOG_API_PORT=3005
EXPOSE 3005

ENTRYPOINT ["/api-entrypoint.sh"]
