# Blog API secret used by n8n (Authorization: Bearer ...)
BLOG_API_SECRET=change-me-to-a-long-random-secret

# API port (default 3005)
BLOG_API_PORT=3005

# Public site URL (used in sitemap + absolute post URLs)
SITE_URL=https://phonedelta.github.io/Ai-Systems-Store

# Frontend: leave empty in local (Vite proxies /api → localhost:3005)
# In production, set to your deployed Blog API URL, e.g. https://your-api.onrender.com
VITE_BLOG_API_URL=
