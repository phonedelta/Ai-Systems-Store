# Blog API secret used by n8n (Authorization: Bearer ...)
BLOG_API_SECRET=change-me-to-a-long-random-secret

# API listen port (local default 3005)
BLOG_API_PORT=3005

# Public site URL (sitemap + absolute post URLs)
SITE_URL=http://localhost:2005

# Frontend: leave empty in local (Vite proxies /api → localhost:3005)
# In production on Railway with same-origin API, leave empty too
VITE_BLOG_API_URL=

# Optional: override image storage root (default: /data on Railway, ./data locally)
# RAILWAY_VOLUME_MOUNT_PATH=/data
# BLOG_DATA_DIR=
